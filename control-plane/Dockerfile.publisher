# The Publisher Job: fixed code (no LLM, no agent). It needs git, so the final image is alpine, not distroless.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/publisher ./cmd/publisher

FROM alpine:3.20
RUN apk add --no-cache git ca-certificates
COPY --from=build /out/publisher /publisher
USER 65532:65532
ENTRYPOINT ["/publisher"]
