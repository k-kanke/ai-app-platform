# The LLM gateway: the only place that holds the provider API key. Static binary on distroless.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/llm-gateway ./cmd/llm-gateway

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/llm-gateway /llm-gateway
USER 65532:65532
ENTRYPOINT ["/llm-gateway"]
